# SkinAI Environment Configuration Example
# Copy this file to .env and populate real credentials

# -------------------------------------------------------------
# Telegram Bot Settings
# -------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_DEFAULT_LOCALE="ru"

# -------------------------------------------------------------
# Backend API & Server Settings
# -------------------------------------------------------------
API_HOST="127.0.0.1"
API_PORT=8000
API_URL="http://127.0.0.1:8000"
API_SECRET_KEY="replace_with_random_secret_string"
DEBUG=true

# -------------------------------------------------------------
# Database Settings (PostgreSQL or local SQLite for dev)
# -------------------------------------------------------------
DATABASE_URL="sqlite+aiosqlite:///./skinai_dev.db"
# Production example:
# DATABASE_URL="postgresql+asyncpg://skinai_user:skinai_password@db:5432/skinai_db"

# Salt for hashing Telegram user IDs before telemetry logging
TELEMETRY_SALT="replace_with_random_salt_for_user_hash"

# -------------------------------------------------------------
# Storage & Model Artifact Paths
# -------------------------------------------------------------
# Redirect data and model storage to secondary disk if C:\ has low space:
SKINAI_DATA_DIR="G:/skinai/data"
SKINAI_ARTIFACTS_DIR="G:/skinai/artifacts"

# Active Model Versions per Profile
SKINAI_ACTIVE_DERMOSCOPY_MODEL="0.1.0"
SKINAI_ACTIVE_SMARTPHONE_MODEL="0.1.0"

# Model Execution Engine: "onnx" or "torch"
SKINAI_INFERENCE_ENGINE="onnx"
